# RunbookGuard 环境变量模板。
# 复制为 .env（已被 .gitignore 屏蔽，绝不提交）并填入真实值。
# 凭据只从环境变量注入，绝不写入任何仓库文件（威胁 T-3）。

# ---- 模型 Provider（全部可选：默认 fake，零网络零成本）----
# 要用真实模型时设为 openai-compatible
RUNBOOKGUARD_LLM_PROVIDER=fake
# OpenAI-compatible 网关地址（含 /v1）
RUNBOOKGUARD_LLM_BASE_URL=
# 模型名。必须在 apps/.../provider/pricing.py 的计价表里，
# 否则配置了 MAX_COST_MICROS 时启动会被拒绝（见 pricing fail-closed）
RUNBOOKGUARD_LLM_MODEL=
RUNBOOKGUARD_LLM_API_KEY=
# 进程级防呆闸
RUNBOOKGUARD_LLM_MAX_CALLS=20
RUNBOOKGUARD_LLM_MAX_COST_MICROS=0

# ---- compose 端口（撞端口时改这里）----
MYSQL_PORT=3307
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
CONTROL_PLANE_PORT=8080
MANAGEMENT_PORT=9080
AGENT_RUNTIME_PORT=8100
SYNTHETIC_LAB_PORT=8090
QDRANT_PORT=6333
CONSOLE_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- 中间件凭据（仅本地演示默认值，真实部署必须改）----
MYSQL_PASSWORD=local-dev-only
MYSQL_ROOT_PASSWORD=local-dev-root
RABBITMQ_USER=runbookguard
RABBITMQ_PASSWORD=local-dev-only
